NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,https://bookleaf-support-mauve.vercel.app
DATABASE_URL=postgresql://bookleaf:bookleaf_dev_password@localhost:5432/bookleaf?schema=public
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
SEED_ADMIN_NAME=BookLeaf Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password-now
# Optional: local development only; assigns one password to newly seeded authors.
SEED_SAMPLE_AUTHOR_PASSWORD=
# Optional server-only key. Leave blank until you add the real key to server/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000
# Optional path to the assignment's BookLeaf Knowledge Base text/Markdown file.
BOOKLEAF_KNOWLEDGE_BASE_PATH=knowledge/bookleaf.md
